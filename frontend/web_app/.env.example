# Frontend Environment Variables
# Copy this file to .env.local for local development
# For production deployment, set these values in your hosting platform

# Backend API URL (WITHOUT /api suffix - it's added automatically in api.js)
# Development: http://localhost:8000
# Production: https://your-render-app-name.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Environment
VITE_ENVIRONMENT=development

# Optional: Map API Keys (if using external map services)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
