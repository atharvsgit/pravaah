# AI worker environment variables.
# Copy this file to ai/.env and fill in real values.

# --- Required by ai/config.py ---
GEMINI_API_KEY=""
HUGGING_FACE_TOKEN=""

# --- RabbitMQ (where the worker pulls nlp_queue from) ---
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# --- Backend (where the worker POSTs verifications back) ---
BACKEND_URL="http://localhost:8000"

# --- Optional: HuggingFace Space fallback classifier ---
# When unset/empty, the worker short-circuits to {"hazard_type": "other"}.
HF_FALLBACK_URL=""

# --- Postgres (only used by the optional social-media scrapers; not needed
#     for the NLP worker itself) ---
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="pravaah_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
